from pydub import AudioSegment
from pydub.generators import WhiteNoise


# Adds white noise to the input audio.
# Parameters:
# input_audio_path (str): Path to the user's input audio file.
# output_audio_path (str): Path where the output audio with noise
# will be saved.
# noise_level (float): Volume of the background noise in decibels
# (default: -20 dB).


def add_white_noise(input_audio_path, output_audio_path,
                    duration, noise_level):

    """
    Adds white noise to an input audio file
    and exports the result.

    Parameters:
    ----------
    input_audio_path : str
        Path to the input audio file.
    output_audio_path : str
        Path where the output audio file with white noise will be saved.
    noise_level : float
        Gain (in dB) to apply to the white noise, controlling its volume.

    Notes:
    -----
    - White noise is generated and mixed with the selected audio segment.
    - The resulting audio is exported as a WAV file to
    the specified output path.
    """

    # Load user audio
    # AudioSegment manipulates audio files (e.g. loading and slicing audio)
    user_audio = AudioSegment.from_file(input_audio_path)

    # Generate white noise
    noise = WhiteNoise().to_audio_segment(duration=duration)
    noise = noise.apply_gain(noise_level)

    # Mix audio and noise
    mixed = user_audio.overlay(noise)

    # Export the result
    mixed.export(output_audio_path, format="wav")
    print(f"Output saved to: {output_audio_path}")
