import numpy as np


def generate_colored_noise(color, length, sr):
    """
    Generate colored noise (white, pink, or brown) of a given length and
    sampling rate.

    Parameters:
        color (str): Type of noise to generate. Supported values are:
                     - 'white': flat power across all frequencies.
                     - 'pink' : power decreases as 1/sqrt(frequency).
                     - 'brown': power decreases as 1/frequency.
        length (int): Number of samples in the noise signal (should match
            audio length).
        sr (int): Sampling rate of the signal, used to compute frequency bins.

    Returns:
        np.ndarray: Time-domain noise signal of specified color and length.

    Notes:
        - Pink and brown noise are generated by shaping white noise in the
          frequency domain.
        - A small epsilon (1e-6) is added to frequency values to avoid
          division by zero.
    """
    # Create a new random number generator instance (modern and reproducible)
    rng = np.random.default_rng()

    # Generate white noise: random values from a standard normal distribution
    # (mean=0, std=1)
    white = rng.normal(0, 1, length)

    # If white noise is requested, return it as is
    if color == 'white':
        return white

    # Transform the white noise to the frequency domain using real FFT
    fft = np.fft.rfft(white)

    # Get the corresponding frequencies for each FFT bin (in Hz)
    freqs = np.fft.rfftfreq(len(white), 1/sr)

    # If pink noise is requested: apply 1/sqrt(f) scaling to the FFT
    if color == 'pink':
        fft /= np.sqrt(freqs + 1e-6)  # avoid divide-by-zero

    # If brown noise is requested: apply 1/f scaling to the FFT
    elif color == 'brown':
        fft /= (freqs + 1e-6)

    # Convert the scaled frequency-domain signal back to time domain
    # using inverse real FFT
    colored = np.fft.irfft(fft)

    # Ensure output has the exact desired length
    return colored[:length]
